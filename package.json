{
  "name": "rigforge",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --filter @rigforge/editor dev",
    "build": "pnpm -r --filter ./packages/** build && pnpm --filter @rigforge/editor build",
    "build:wasm": "bash scripts/build-wasm.sh",
    "build:presets": "pnpm --filter @rigforge/presets build:presets",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
