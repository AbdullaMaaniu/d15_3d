{
  "name": "rigforge",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --filter @rigforge/editor dev",
    "build": "pnpm -r --filter \"./packages/**\" build && pnpm --filter @rigforge/editor build",
    "build:wasm": "bash scripts/build-wasm.sh",
    "build:presets": "pnpm --filter @rigforge/presets build:presets",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "corpus": "tsx scripts/corpus-report.ts",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "tsx": "^4.20.0",
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "three": "^0.186.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
