{
  "name": "@rigforge/cli",
  "version": "0.1.0",
  "description": "Batch auto-rig and animate Meshy.ai (or any) GLB models from the command line.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "rigforge": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/cli.ts"
  },
  "dependencies": {
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@rigforge/core": "workspace:*",
    "@rigforge/presets": "workspace:*",
    "meshoptimizer": "^1.3.0",
    "three": "^0.186.1",
    "@gltf-transform/functions": "^4.5.0"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "tsup": "^8.5.1",
    "tsx": "^4.20.0"
  }
}
