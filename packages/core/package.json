{
  "name": "@rigforge/core",
  "version": "0.1.0",
  "description": "RigForge core: mesh prep, humanoid auto-rigging, skin weights, retargeting and glTF export for three.js.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./wasm/rigforge_kernels.wasm": "./wasm/rigforge_kernels.wasm"
  },
  "files": [
    "dist",
    "wasm"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./wasm/rigforge_kernels.wasm": "./wasm/rigforge_kernels.wasm"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --external three",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "three": ">=0.160.0"
  },
  "dependencies": {
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "meshoptimizer": "^1.3.0"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "three": "^0.186.1",
    "tsup": "^8.5.1"
  }
}
